"""Fill individual OPEX Tableau values in an EXISTING consolidated validation report.
Does not rerun consolidated Tableau or change financial-statement data.
"""
import argparse
import shutil
from datetime import date
from pathlib import Path
from openpyxl import load_workbook
from automations.actuals.individual_actuals_validation_service import run_individual_opex_pilot
from automations.actuals.validation_config import INDIVIDUAL_OPEX_ACTUALS_MAPPINGS


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--report', required=True)
    parser.add_argument('--aliv-fs', required=True)
    parser.add_argument('--cbl-fs')
    parser.add_argument('--period', required=True, help='YYYY-MM-DD')
    parser.add_argument('--company', choices=['ALIV', 'CBL', 'Both'], default='ALIV')
    parser.add_argument('--all-routes', action='store_true', help='Process all mapped workbooks, not just pilot-enabled routes')
    parser.add_argument('--output', help='Output folder for audit files; defaults to report parent')
    parser.add_argument('--wait', type=float, default=8)
    args = parser.parse_args()
    period = date.fromisoformat(args.period)
    report = Path(args.report).resolve()
    if not report.is_file():
        parser.error(f'Existing report not found: {report}')
    if not Path(args.aliv_fs).is_file():
        parser.error(f'ALIV statement not found: {args.aliv_fs}')
    if args.company in ('CBL', 'Both') and (not args.cbl_fs or not Path(args.cbl_fs).is_file()):
        parser.error('CBL statement required and must exist for CBL/Both')
    with load_workbook(report, read_only=True) as wb:
        required = {'Executive Summary', 'ALIV OPEX', 'CBL OPEX'}
        if not required.issubset(wb.sheetnames):
            parser.error('This is not the expected consolidated OPEX report')
    selected = {'ALIV', 'CBL'} if args.company == 'Both' else {args.company}
    routes = [m for m in INDIVIDUAL_OPEX_ACTUALS_MAPPINGS
              if m['company'] in selected and (args.all_routes or m.get('individual_actuals_enabled'))]
    if not routes:
        parser.error('No routes selected')
    print(f'Selected {len(routes)} mapped workbooks:', flush=True)
    for m in routes:
        source = Path(m['individual_tableau_workbook'])
        print(f'  {m["company"]} / {m["fs_line"]}: {source} ({"EXISTS" if source.is_file() else "MISSING"})', flush=True)
    missing = [m['individual_tableau_workbook'] for m in routes if not Path(m['individual_tableau_workbook']).is_file()]
    if missing:
        parser.error(f'Mapped Tableau files missing: {missing}')
    backup = report.with_name(report.stem + '_before_individual' + report.suffix)
    if not backup.exists():
        shutil.copy2(report, backup)
    print('Report backup:', backup, flush=True)
    output = Path(args.output).resolve() if args.output else report.parent
    paths = {'tableau_raw_copies': str(output / 'Tableau_Raw_Copies')}
    result = run_individual_opex_pilot(
        report_path=report, aliv_fs_path=args.aliv_fs, cbl_fs_path=args.cbl_fs,
        output_paths=paths, closed_period=period, wait_seconds=args.wait,
        tableau_settings={'company': args.company}, include_all_mapped=args.all_routes,
    )
    print('\nINDIVIDUAL CAPTURE COMPLETE')
    print('Report:', report)
    print('Raw audit:', result['audit_workbook'])
    print('Individual status:', result['status'])
    print('Monthly/YTD statuses:', result['statuses'])
    print('Existing consolidated exceptions remain unchanged.')

if __name__ == '__main__':
    main()
