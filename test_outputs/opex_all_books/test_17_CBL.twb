          <datasource-dependencies datasource="Parameters">
            <column caption="Forecast Start " datatype="date" name="[Parameter 1 1 1]" param-domain-type="list" role="measure" type="quantitative" value="#2026-09-01#">
              <calculation class="tableau" formula="#2026-09-01#" />
            </column>
            <column caption="Forecast Measure " datatype="string" name="[Parameter 2 1]" param-domain-type="list" role="measure" type="nominal" value="&quot;Forecast&quot;">
