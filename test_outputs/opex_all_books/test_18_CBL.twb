      <column caption="Prior YTD " datatype="real" name="[Budget YTD (copy)_271623394685104128]" role="measure" type="quantitative">
        <calculation class="tableau" formula="if [GL Posting Date] &gt;= [Parameters].[Parameter 1 1 1] THEN 0&#13;&#10;ELSE [Prior Year] END" />
      </column>
      <column aggregation="Sum" caption="Annual Budget" datatype="real" default-type="quantitative" layered="true" name="[Budget]" pivot="key" role="measure" type="quantitative" user-datatype="real" visual-totals="Default" />
      <column aggregation="Count" datatype="string" default-type="nominal" layered="true" name="[Buy-from Vendor No.]" pivot="key" role="dimension" type="nominal" user-datatype="string" visual-totals="Default" />
      <column caption="Zero Filter_YTD_Forecast_Prior Year" datatype="integer" name="[Calculation_1307169847408324608]" role="measure" type="ordinal">
        <calculation class="tableau" formula="IF SUM(ZN([Calculation_2242792614510776320]))=0  AND  SUM(ZN ([Calculation_2242792614511521793]))=0 AND  SUM(ZN ([Budget]))=0 AND  (ZN(SUM([Calculation_2876111377606590464]))) = 0 AND  (ZN(SUM([Prior Year]))) = 0 THEN 0 ELSE 1 END" />
      </column>
      <column caption="Include Income Statement Closing Entries" datatype="boolean" name="[Calculation_168603519054684161 1]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [GL Document No.] = &quot;GL001773&quot;&#13;&#10;//Cable FY25&#13;&#10;// or [GL Document No.] = &quot;&quot;&#13;&#10;//Cable FY24&#13;&#10;or [GL Document No.] = &quot;GL003495&quot;&#13;&#10;//Aliv FY25&#13;&#10;// or [GL Document No.] = &quot;&quot;&#13;&#10;//Aliv FY24&#13;&#10;then false &#13;&#10;else true&#13;&#10;end" />
      </column>
      <column caption="Var YTD $" datatype="real" name="[Calculation_2151594753815617536 1]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(ZN([Calculation_2242792614510776320]))-SUM(ZN([Calculation_2242792614511521793]))" />
      </column>
      <column caption="Var $" datatype="real" name="[Calculation_2151594753815617536]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([Actual])-SUM([Budget])" />
      </column>
      <column caption="Actual YTD" datatype="real" name="[Calculation_2242792614510776320]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF [GL Posting Date] &gt;= #2026-07-01# AND [GL Posting Date] &lt; #2026-09-01# THEN [Actual] ELSE 0 END" />
      </column>
      <column caption="Budget YTD" datatype="real" name="[Calculation_2242792614511521793]" role="measure" type="quantitative">
        <calculation class="tableau" formula="if [GL Posting Date] &gt;= [Parameters].[Parameter 1 1 1] THEN 0&#13;&#10;ELSE [Budget] END" />
      </column>
      <column caption="Annual Forecast" datatype="real" name="[Calculation_2876111377606590464]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF  [GL Posting Date] &gt;= [Parameters].[Parameter 1 1 1]  THEN &#13;&#10;    IF [Parameters].[Parameter 2 1]  = 'Forecast' THEN [Forecast]&#13;&#10;    ELSEIF [Parameters].[Parameter 2 1] = 'Budget' THEN [Budget]&#13;&#10;    ELSEIF [Parameters].[Parameter 2 1] = 'Actual' THEN [Actual]&#13;&#10;    ELSEIF [Parameters].[Parameter 2 1] = 'Y over Y Actual' THEN [Prior Year]&#13;&#10;     END&#13;&#10;ELSE  [Actual] END" />
      </column>
