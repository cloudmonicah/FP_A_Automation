        <calculation class="tableau" formula="IF [GL Document No.] = &quot;GL001773&quot;&#13;&#10;//Cable FY25&#13;&#10;// or [GL Document No.] = &quot;&quot;&#13;&#10;//Cable FY24&#13;&#10;or [GL Document No.] = &quot;GL003495&quot;&#13;&#10;//Aliv FY25&#13;&#10;// or [GL Document No.] = &quot;&quot;&#13;&#10;//Aliv FY24&#13;&#10;then false &#13;&#10;else true&#13;&#10;end" />
      </column>
      <column caption="Var YTD $" datatype="real" name="[Calculation_2151594753815617536]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([Calculation_2242792614510776320])-SUM([Calculation_2242792614511521793])" />
      </column>
      <column caption="Actual YTD" datatype="real" name="[Calculation_2242792614510776320]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF [GL Posting Date] &gt;= #2026-07-01# AND [GL Posting Date] &lt; #2026-09-01# THEN [Actual] ELSE 0 END" />
      </column>
      <column caption="Budget YTD" datatype="real" name="[Calculation_2242792614511521793]" role="measure" type="quantitative">
        <calculation class="tableau" formula="if [GL Posting Date] &gt;= [Parameters].[Parameter 1 1] THEN 0&#13;&#10;ELSE [Budget] END" />
      </column>
      <column caption="Annual Forecast" datatype="real" name="[Calculation_2876111377606590464]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF  [GL Posting Date] &gt;= [Parameters].[Parameter 1 1]  THEN &#13;&#10;    IF [Parameters].[Parameter 2]  = 'Forecast' THEN [Forecast]&#13;&#10;    ELSEIF [Parameters].[Parameter 2] = 'Budget' THEN [Budget]&#13;&#10;    ELSEIF [Parameters].[Parameter 2] = 'Actual' THEN [Actual]&#13;&#10;    ELSEIF [Parameters].[Parameter 2] = 'Y over Y Actual' THEN [Prior Year]&#13;&#10;     END&#13;&#10;ELSE  [Actual] END" />
      </column>
