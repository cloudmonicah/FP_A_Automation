          </datasources>
          <datasource-dependencies datasource="Parameters">
            <column caption="Forecast Start   " datatype="date" name="[Parameter 1 1 1 1 1]" param-domain-type="list" role="measure" type="quantitative" value="#2026-09-01#">
              <calculation class="tableau" formula="#2026-09-01#" />
            </column>
            <column caption="Forecast Measure   " datatype="string" name="[Parameter 2 1 1 1]" param-domain-type="list" role="measure" type="nominal" value="&quot;Forecast&quot;">
              <calculation class="tableau" formula="&quot;Forecast&quot;" />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="sqlproxy.18iulla0dtvxx41fg2g7p16wzvu6">
