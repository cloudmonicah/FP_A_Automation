    <worksheet name="ALIV CONSUMER SOLUTIONS - Account Summary by Subdepartment_Actual v Budget v Forecast">
      <layout-options>
        <title>
          <formatted-text>
            <run fontname="Georgia">&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="CBL Group_Financial Transactions_Consumer_Product Dev &amp; Marketing" name="sqlproxy.1q7jkdq1jk94gs11cfzyh03awr2o" />
            <datasource name="Parameters" />
          </datasources>
          <datasource-dependencies datasource="Parameters">
            <column caption="Forecast Start " datatype="date" name="[Parameter 1 1 1]" param-domain-type="list" role="measure" type="quantitative" value="#2026-09-01#">
              <calculation class="tableau" formula="#2026-09-01#" />
            </column>
            <column caption="Forecast Measure " datatype="string" name="[Parameter 2 1]" param-domain-type="list" role="measure" type="nominal" value="&quot;Forecast&quot;">
              <calculation class="tableau" formula="&quot;Forecast&quot;" />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="sqlproxy.1q7jkdq1jk94gs11cfzyh03awr2o">
            <column aggregation="Sum" datatype="real" default-type="quantitative" layered="true" name="[Actual]" pivot="key" role="measure" type="quantitative" user-datatype="real" visual-totals="Default" />
            <column aggregation="Count" datatype="string" default-type="nominal" layered="true" name="[Budget Type]" pivot="key" role="dimension" type="nominal" user-datatype="string" visual-totals="Default" />
            <column aggregation="Sum" caption="Annual Budget" datatype="real" default-type="quantitative" layered="true" name="[Budget]" pivot="key" role="measure" type="quantitative" user-datatype="real" visual-totals="Default" />
            <column caption="Zero Filter_Actuals_Forecast" datatype="integer" name="[Calculation_1143914361173504002]" role="measure" type="ordinal">
              <calculation class="tableau" formula="IF SUM(ZN([Calculation_2242792614510776320]))=0  AND  SUM(ZN ([Calculation_2242792614511521793]))=0 AND  SUM(ZN ([Budget]))=0 AND  (ZN(SUM([Calculation_2876111377606590464]))) = 0 THEN 0 ELSE 1 END" />
            </column>
            <column caption="Var YTD $" datatype="real" name="[Calculation_2151594753815617536 1]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(ZN([Calculation_2242792614510776320]))-SUM(ZN([Calculation_2242792614511521793]))" />
            </column>
            <column caption="Actual YTD" datatype="real" name="[Calculation_2242792614510776320]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IF [GL Posting Date] &gt;= #2026-07-01# AND [GL Posting Date] &lt; #2026-09-01# THEN [Actual] ELSE 0 END" />
            </column>
            <column caption="Budget YTD" datatype="real" name="[Calculation_2242792614511521793]" role="measure" type="quantitative">
              <calculation class="tableau" formula="if [GL Posting Date] &gt;= [Parameters].[Parameter 1 1 1] THEN 0&#13;&#10;ELSE [Budget] END" />
            </column>
            <column caption="Annual Forecast" datatype="real" name="[Calculation_2876111377606590464]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IF  [GL Posting Date] &gt;= [Parameters].[Parameter 1 1 1]  THEN &#13;&#10;    IF [Parameters].[Parameter 2 1]  = 'Forecast' THEN [Forecast]&#13;&#10;    ELSEIF [Parameters].[Parameter 2 1] = 'Budget' THEN [Budget]&#13;&#10;    ELSEIF [Parameters].[Parameter 2 1] = 'Actual' THEN [Actual]&#13;&#10;    ELSEIF [Parameters].[Parameter 2 1] = 'Y over Y Actual' THEN [Prior Year]&#13;&#10;     END&#13;&#10;ELSE  [Actual] END" />
            </column>
